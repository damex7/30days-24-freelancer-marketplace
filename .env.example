# Neon: use the POOLED connection string (host contains "-pooler").
# For a local Postgres instead: postgres://user:pass@localhost:5432/gigroom
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Your site's address, used in email links. On Vercel, set it to the live URL.
APP_URL=http://localhost:3000

# Resend: leave RESEND_API_KEY empty and emails are printed in the terminal instead.
# Until you verify a domain in Resend, EMAIL_FROM must be onboarding@resend.dev,
# and Resend only delivers to the email address of your own Resend account.
RESEND_API_KEY=
EMAIL_FROM=Gigroom <onboarding@resend.dev>

# Passwords for the seeded accounts (npm run db:seed). At least 8 characters.
SEED_USER_PASSWORD=change-me-please
SEED_ADMIN_PASSWORD=change-me-too-please
